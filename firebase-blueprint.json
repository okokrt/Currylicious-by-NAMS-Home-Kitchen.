{
  "entities": {
    "menuItems": {
      "title": "Menu Item",
      "description": "Food dishes available on the menu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "spicyLevel": { "type": "string" },
        "isVegetarian": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "isAvailable": { "type": "boolean" },
        "preparationTimeMinutes": { "type": "number" }
      },
      "required": ["id", "name", "price", "category", "isAvailable"]
    },
    "storeSettings": {
      "title": "Store Settings",
      "description": "Global settings for the restaurant",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "restaurantName": { "type": "string" },
        "tagline": { "type": "string" },
        "isStoreOpen": { "type": "boolean" },
        "announcement": { "type": "string" }
      },
      "required": ["whatsappNumber", "isStoreOpen"]
    },
    "feedbacks": {
      "title": "Feedback",
      "description": "Customer reviews and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 3000 },
        "dishName": { "type": "string", "maxLength": 200 },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/menuItems/{itemId}": {
      "schema": "menuItems",
      "description": "Collection of menu items"
    },
    "/settings/{settingId}": {
      "schema": "storeSettings",
      "description": "Store settings document"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "feedbacks",
      "description": "Collection of customer feedbacks"
    }
  }
}
