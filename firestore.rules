rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidFeedback(data) {
      return data.id is string
        && data.customerName is string && data.customerName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 3000
        && data.createdAt is string
        && (!('dishName' in data) || (data.dishName is string && data.dishName.size() <= 200))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000));
    }

    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if isValidFeedback(request.resource.data);
      allow delete: if true;
      allow update: if false;
    }

    match /menuItems/{itemId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
